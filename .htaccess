# ---------------------------------------------------------------
#  Clean URLs, speed and safety for the online store
#  (If the website is in a sub-folder, e.g. /shop, add:   RewriteBase /shop/ )
# ---------------------------------------------------------------
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /e-commerce-crm/website/404.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /e-commerce-crm/website/

RewriteRule ^product/([0-9]+)(-[^/]*)?/?$        product.php?id=$1        [L,QSA]
RewriteRule ^category/([a-z0-9-]+)/?$            shop.php?cat=$1          [L,QSA]
RewriteRule ^page/([a-z0-9-]+)/?$                page.php?slug=$1         [L,QSA]
RewriteRule ^account/?$                          account.php              [L,QSA]
RewriteRule ^account/profile/?$                  account.php?tab=profile  [L,QSA]
RewriteRule ^account/orders/?$                   orders.php               [L,QSA]
RewriteRule ^account/order/([A-Za-z0-9-]+)/?$    order.php?no=$1          [L,QSA]
RewriteRule ^account/addresses/?$                addresses.php            [L,QSA]
RewriteRule ^order-success/([A-Za-z0-9-]+)/?$    order-success.php?no=$1  [L,QSA]
RewriteRule ^payment/(pay|verify|failed|webhook)/?$ payment-$1.php        [L,QSA]
RewriteRule ^(shop|cart|checkout|wishlist|login|register|verify|logout|faq|contact|forgot-password)/?$ $1.php [L,QSA]
RewriteRule ^sitemap\.xml$                       sitemap.php              [L]
RewriteRule ^robots\.txt$                        robots.php               [L]
</IfModule>

# files nobody should download
<FilesMatch "^(config|config\.sample)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md|log|bak)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/webp "access plus 6 months"
</IfModule>
